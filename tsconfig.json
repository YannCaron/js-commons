{
  "compilerOptions": {
    "types": [
      "node"
    ],
    "module": "commonjs",
    "target": "es2017",
    "declaration": true,
    "outDir": "dist/",
    /* Linting */
    "strict": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/**/*",
    "index.ts"
  ],
  "exclude": [
    "node_modules",
    "tests/**/*",
    "dist/**/*"
  ]
}